{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f9e2fd33-4dbc-48f5-a11a-b6c58dfda456","database_name": "nova-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0baa314e2fa4475ca23dd0d0cc69e7ce" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
